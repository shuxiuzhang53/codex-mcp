# Copy this file to (in the repo root, next to this .example):
#   ./mcp-literature.env
# Then fill in real values. Keep the real file private.

# Used by Unpaywall and paper-search providers that require contact email.
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL="your-email@example.com"
UNPAYWALL_EMAIL="your-email@example.com"

# Optional. Semantic Scholar works better with an API key, but basic use may work without one.
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=""

# Zotero access mode:
#
# If Zotero 7+ is installed on this computer, start Zotero and enable:
#   Settings/Preferences -> Advanced -> API ->
#   Allow other applications on this computer to communicate with Zotero
#
# Local mode does not require ZOTERO_API_KEY or ZOTERO_LIBRARY_ID.
#
# IMPORTANT: Zotero's local API is READ-ONLY. In pure local mode you can
# search/read the library, but importing (creating collections, adding items,
# attaching PDFs) does NOT work — writes require the Web API. For the
# search->import->translate workflow, keep Web API for the import (write) half.
#
# Web API mode is recommended when Codex runs in WSL/sandbox and cannot reach
# Windows Zotero at localhost:23119. To use local reads, switch WSL to
# mirrored networking first, then flip with: ./set-zotero-mode.sh local
ZOTERO_LOCAL="false"

# Zotero Web API:
# 1. Open https://www.zotero.org/settings/keys
# 2. Create a key with library read/write permissions.
# 3. User library ID is visible at https://www.zotero.org/settings/keys
# Only required when ZOTERO_LOCAL is not true, or when using hybrid/web writes.
ZOTERO_API_KEY="paste-your-zotero-api-key-here"
ZOTERO_LIBRARY_ID="paste-your-zotero-user-id-here"
ZOTERO_LIBRARY_TYPE="user"

# --- Semantic search embeddings (optional) ---
# zotero-mcp semantic search uses an OpenAI-compatible embedding API.
# SiliconFlow works great and is cheap: model BAAI/bge-m3 (1024d, strong zh+en).
# The api_key is read from OPENAI_API_KEY; base_url + model live in
# ~/.config/zotero-mcp/config.json (see README "Semantic search").
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.siliconflow.cn/v1"

# Useful when local MCP clients communicate with local services.
NO_PROXY="localhost,127.0.0.1"
